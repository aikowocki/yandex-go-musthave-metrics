cmd/agent/main
cmd/agent/agent
cmd/server/main
cmd/server/server

# Dependency directories (remove the comment below to include it)
vendor/

# IDEs directories
.idea
.vscode

# Environment files
.env
deployments/.env
deployments/config/*
!deployments/config/*.example.json
deployments/data
