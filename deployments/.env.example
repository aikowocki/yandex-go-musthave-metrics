POSTGRES_USER=yandex
POSTGRES_PASSWORD=password
POSTGRES_DB=metrics

KEY=key

# RSA encryption
KEYS_DIR=./keys # Путь к папке с ключами на хосте (маунтит как /keys в контейнерах)
# Пути внутри контейнера
SERVER_CRYPTO_KEY=/keys/private.pem
AGENT_CRYPTO_KEY=/keys/public.pem

# Agent worker pool size
RATE_LIMIT=5

# Audit
AUDIT_FILE=/data/audit.jsonl
AUDIT_URL=https://webhook.site/1f49b66d-8ccb-4dc5-abd4-d0ef8622a931

# Доверенная подсеть (CIDR). Должна совпадать с подсетью networks.metrics-net
# в docker-compose.yml. Пусто — проверка X-Real-IP отключена.
TRUSTED_SUBNET=172.28.0.0/16

# gRPC
# Сервер слушает на этом адресе, агент подключается к server:3200
#GRPC_ADDRESS=0.0.0.0:3200
#AGENT_GRPC_ADDRESS=server:3200